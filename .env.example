LOG_LEVEL=INFO

# Telephony
PUBLIC_BASE_URL=
TWILIO_AUTH_TOKEN=

# Agent model
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Technician calendars through Composio. The user ID must own a connected Google Calendar account
# that can read and write every calendar listed in data/technicians.csv (name,calendar_id).
COMPOSIO_API_KEY=ak_...
COMPOSIO_USER_ID=summit-air

# Urgent issues are emailed here, from the Gmail account connected under COMPOSIO_USER_ID
COMPANY_EMAIL=
EMAIL_FROM=

# Business schedule (Monday = 0)
BUSINESS_TIMEZONE=America/New_York
BUSINESS_WEEKDAYS=0,1,2,3,4
BUSINESS_START_HOUR=8
BUSINESS_END_HOUR=17
SERVICE_CALL_MINUTES=15
BOOKING_HORIZON_DAYS=14

